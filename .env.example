# Kopiera denna fil till .env och fyll i dina egna nycklar.
# .env laddas ALDRIG upp till git (se .gitignore).

# --- Steg 3: GitHub MCP ---
# GITHUB_PERSONAL_ACCESS_TOKEN=

# --- Steg 5: Reddit MCP ---
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=

# --- Steg 6: Alpha Vantage MCP (marknadsdata) ---
# ALPHA_VANTAGE_API_KEY=

# --- Fas 1: Market Opportunity Intelligence System ---
# ANTHROPIC_API_KEY=

# OBS: Fas 1:s kod (intelligence/config.py) läser ALPHAVANTAGE_API_KEY (utan
# understreck) — inte ALPHA_VANTAGE_API_KEY ovan. Fel variabelnamn stängs av
# tyst (fault-tolerant connector-skip) utan synligt fel, så dubbelkolla stavningen.
# ALPHAVANTAGE_API_KEY=

# Valfria inställningar (default-värden i intelligence/config.py används om
# dessa lämnas okommenterade/borttagna):
# DB_PATH_OVERRIDE=
# MAX_EVENTS_PER_RUN=20
# MAX_OPPORTUNITIES_PER_RUN=5
# MAX_AGENT_CALLS_PER_RUN=50
# AGENT_TIMEOUT_SECONDS=30
# CONNECTOR_TIMEOUT_SECONDS=10
# CONNECTOR_MAX_RETRIES=3
